#!/usr/bin/env python3
"""openml-secret — fetch/store OpenML Vault secrets from any project.

Talks to the OpenML console's localhost API. Multiple vaults, project scopes.

    openml-secret get OPENAI_API_KEY --vault work --scope global
    openml-secret set DB_PASSWORD s3cr3t --vault work --scope webapp
    openml-secret list --vault work --scope webapp
    openml-secret vaults                      # list vaults
    export OPENML_VAULT_CODE=...              # access code to auto-unlock

Env: OPENML_CONSOLE (default http://localhost:8080), OPENML_VAULT_CODE.
Pure stdlib — no third-party dependencies.
"""
import argparse
import json
import os
import sys
import urllib.error
import urllib.request

BASE = os.environ.get("OPENML_CONSOLE", "http://localhost:8080").rstrip("/")


def call(method, path, body=None):
    data = json.dumps(body).encode() if body is not None else None
    headers = {"Content-Type": "application/json"} if data else {}
    req = urllib.request.Request(BASE + path, data=data, method=method, headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=10) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        try:
            msg = json.load(e).get("detail", e.reason)
        except Exception:
            msg = e.reason
        sys.exit(f"error: {msg}")
    except urllib.error.URLError as e:
        sys.exit(f"error: cannot reach OpenML console at {BASE} ({e.reason})")


def find_vault(name):
    st = call("GET", "/api/vault/status")
    if not st.get("ok"):
        sys.exit("error: vault backend unavailable (is core Postgres running?)")
    for v in st.get("vaults", []):
        if v["name"] == name:
            return v
    have = ", ".join(v["name"] for v in st.get("vaults", [])) or "(none)"
    sys.exit(f"error: no vault named '{name}'. Existing: {have}. Create it in the console.")


def ensure_unlocked(v, code):
    if v.get("unsealed"):
        return
    code = code or os.environ.get("OPENML_VAULT_CODE")
    if not code:
        sys.exit(f"error: vault '{v['name']}' is locked — pass --code or set OPENML_VAULT_CODE")
    call("POST", f"/api/vault/{v['id']}/unlock", {"credential": code})


def main():
    p = argparse.ArgumentParser(prog="openml-secret")
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("vaults")
    for name in ("get", "set", "list", "status"):
        sp = sub.add_parser(name)
        sp.add_argument("--vault", default="default")
        sp.add_argument("--scope", default="global", help="'global' or a project name")
        sp.add_argument("--code", default=None, help="access code to unlock if sealed")
        if name == "get":
            sp.add_argument("name")
        if name == "set":
            sp.add_argument("name")
            sp.add_argument("value")
    a = p.parse_args()

    if a.cmd == "vaults":
        st = call("GET", "/api/vault/status")
        for v in st.get("vaults", []):
            print(f"{v['name']}\t{'unlocked' if v['unsealed'] else 'locked'}\t{v['secrets']} secrets")
        return
    if a.cmd == "status":
        print(json.dumps(call("GET", "/api/vault/status"), indent=2))
        return

    v = find_vault(a.vault)
    ensure_unlocked(v, a.code)
    vid = v["id"]
    if a.cmd == "get":
        print(call("GET", f"/api/vault/{vid}/secret/{a.scope}/{a.name}")["value"])
    elif a.cmd == "set":
        call("POST", f"/api/vault/{vid}/secret", {"scope": a.scope, "name": a.name, "value": a.value})
        print(f"set {a.vault}:{a.scope}/{a.name}")
    elif a.cmd == "list":
        for s in call("GET", f"/api/vault/{vid}/secrets?scope={a.scope}")["secrets"]:
            print(f"{s['scope']}/{s['name']}")


if __name__ == "__main__":
    main()
