# ============================================================================
# OpenML — environment configuration
# Copy to `.env` and edit as needed:  cp .env.example .env
# ============================================================================

# --- Project ----------------------------------------------------------------
# Absolute path to this project on the HOST. The control-dashboard container
# mounts this at the SAME path inside the container so that `docker compose`
# run from inside the dashboard resolves bind-mount paths correctly.
#
# The Makefile sets this automatically to $(pwd) — always use `make ...`.
# If you run `docker compose` directly, export it first:
#     export OPENML_PROJECT_DIR=$(pwd)
OPENML_PROJECT_DIR=
COMPOSE_PROJECT_NAME=openml

# --- Docker VM sizing (informational; set this in Docker Desktop settings) ---
# Recommended: give the Docker Desktop VM ~12-14 GB on a 24 GB M4.
# The dashboard reads the VM's real memory limit at runtime for the budget bar.
OPENML_VM_MEM_GB=12

# --- Ports (host side) ------------------------------------------------------
# Interface the host ports bind to. Default 127.0.0.1 = reachable only from
# THIS Mac (recommended, since there is no auth and creds are defaults).
# Set to 0.0.0.0 to expose on your LAN — only after adding auth + real creds.
BIND_HOST=127.0.0.1

DASHBOARD_PORT=8080
JUPYTER_PORT=8888
POSTGRES_PORT=5432
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
REDIS_PORT=6379

# --- Phase 1: telemetry (track + monitor) ---
MLFLOW_PORT=5000
AIM_PORT=43800
AIM_SERVER_PORT=53800
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
CADVISOR_PORT=8082
NODE_EXPORTER_PORT=9100
PUSHGATEWAY_PORT=9091

# --- Phase 2: data & labeling (label) ---
LABELSTUDIO_PORT=8081
LABELSTUDIO_MEM_LIMIT=2g
LABELSTUDIO_USERNAME=admin@openml.local
LABELSTUDIO_PASSWORD=openml-admin

# --- Phase 3: pipelines (pipeline) ---
ZENML_PORT=8237
ZENML_MEM_LIMIT=1g

# Reserved for later phases (kept here so the map is in one place):
# GITEA_PORT=3001
# INFERENCE_PORT=8000
# CAMERA_MJPEG_PORT=8090

# --- Credentials (CHANGE for anything beyond localhost) ---------------------
POSTGRES_USER=openml
POSTGRES_PASSWORD=openml
POSTGRES_DB=openml

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# Buckets created on first boot by the minio-init job
MINIO_BUCKETS=mlflow datasets models

# JupyterLab access token (used as the login password)
JUPYTER_TOKEN=openml

# Memory ceiling for the notebook container. A runaway job is killed at this
# limit instead of OOMing the whole VM. Raise it if you bump the Docker VM.
JUPYTER_MEM_LIMIT=4g

# Grafana admin login (anonymous viewer access is also enabled for convenience)
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
