{
  "uid": "openml-serving",
  "title": "Serving",
  "tags": ["openml"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {"from": "now-30m", "to": "now"},
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Requests / sec",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "openml-prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (endpoint) (rate(bentoml_service_request_total[1m]))", "legendFormat": "{{endpoint}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 8}}, "overrides": []}
    },
    {
      "id": 2, "type": "timeseries", "title": "Latency p95 (s)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "openml-prometheus"},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(bentoml_service_request_duration_seconds_bucket[1m])))", "legendFormat": "p95"}],
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"drawStyle": "line", "lineWidth": 2}}, "overrides": []}
    },
    {
      "id": 3, "type": "stat", "title": "In-progress requests",
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "openml-prometheus"},
      "targets": [{"refId": "A", "expr": "sum(bentoml_service_request_in_progress)"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value"}
    },
    {
      "id": 4, "type": "stat", "title": "Errors / sec (5xx)",
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 8},
      "datasource": {"type": "prometheus", "uid": "openml-prometheus"},
      "targets": [{"refId": "A", "expr": "sum(rate(bentoml_service_request_total{http_response_code=~\"5..\"}[1m]))"}],
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.001}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background"}
    },
    {
      "id": 5, "type": "text", "title": "About",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "options": {"mode": "markdown", "content": "Live metrics from the **BentoML** inference server (`bentoml_service_*`), scraped as the `inference` job. Call `POST :8000/predict` or use the **Playground** (:7860). The raw-FastAPI example emits `openml_inference_*` instead."}
    }
  ]
}
